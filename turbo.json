{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["//#lint:eslint", "lint:types"]
    },
    "//#lint:eslint": {},
    "lint:types": {
      "dependsOn": ["^build", "^lint:types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "persistent": true,
      "cache": false,
      "env": ["SESSION_SECRET", "NODE_ENV"]
    },
    "react-router-typegen": {
      "dependsOn": ["^react-router-typegen"]
    },
    "//#knip": {
      "dependsOn": [
        "@transi-store/common#build",
        "@transi-store/website#react-router-typegen"
      ]
    },
    "//#download-translations": {
      "dependsOn": ["@transi-store/cli#build"],
      "env": ["TRANSI_STORE_API_KEY"]
    },
    "//#upload-translations": {
      "dependsOn": ["@transi-store/cli#build"],
      "env": ["TRANSI_STORE_API_KEY"]
    },
    "//#merge-translation-branch": {
      "dependsOn": ["@transi-store/cli#build"],
      "env": ["TRANSI_STORE_API_KEY"]
    }
  }
}
